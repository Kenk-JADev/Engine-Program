            VALUE "ProductVersion", "0.2.0"
        END
        BLOCK "040904B0" // English US
        BEGIN
            VALUE "CompanyName", "RPG Maker 3D Team"
            VALUE "FileDescription", "RPG Maker 3D Engine - 3D RPG Editor and Runtime"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "RPGMaker3D"
