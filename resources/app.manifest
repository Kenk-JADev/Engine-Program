<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="0.2.0.0" processorArchitecture="*" name="RPGMaker3D.Engine" type="win32"/>
  <description>RPG Maker 3D Engine - 3D RPG Editor</description>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>

  <!--
    WICHTIG: Keine dpiAware / dpiAwareness / gdiScaling hier.
    Jede Manifest-DPI-Angabe setzt Awareness beim Prozessstart.
    Qt 6 ruft danach SetProcessDpiAwarenessContext(V2) auf -> ACCESS_DENIED.

    DPI wird gesetzt in:
      - Qt-Editor: Platform::SetDPIAware() in QtMain VOR QApplication
      - Player/SDL: Platform::SetDPIAware() in Engine/main
  -->

  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0" processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
